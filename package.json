{
  "name": "ts-rapier-core",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter game dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter @francodelportdev/rapier-engine test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~7.0.2"
  }
}
