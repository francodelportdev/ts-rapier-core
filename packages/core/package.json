{
  "name": "@francodelportdev/rapier-engine",
  "version": "0.1.0",
  "description": "Object-oriented 2D game engine built on Rapier physics",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francodelportdev/ts-rapier-core.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target browser --format esm --external @dimforge/rapier2d-compat && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.14.0"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
