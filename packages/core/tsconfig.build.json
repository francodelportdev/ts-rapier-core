{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    // Members marked @internal are for the engine itself: keep them out of the published types.
    "stripInternal": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
